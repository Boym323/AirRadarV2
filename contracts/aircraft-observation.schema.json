{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AircraftObservation G-01 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiverId",
    "transport",
    "aircraftKey",
    "receivedAtUtc",
    "timeBasis",
    "positionOrigin",
    "positionAtUtc",
    "position",
    "callsign",
    "squawk"
  ],
  "properties": {
    "receiverId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "transport": {
      "enum": [
        "readsb_json",
        "beast_tcp"
      ]
    },
    "aircraftKey": {
      "type": "string",
      "pattern": "^(icao|nonicao):[0-9a-f]{6}$"
    },
    "receivedAtUtc": {
      "type": "number"
    },
    "timeBasis": {
      "enum": [
        "derived_readsb",
        "receiver_utc",
        "server_arrival",
        "unknown"
      ]
    },
    "positionOrigin": {
      "enum": [
        "adsb",
        "mlat",
        "tisb",
        "rebroadcast",
        "estimated",
        "unknown"
      ]
    },
    "positionAtUtc": {
      "type": [
        "number",
        "null"
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      ]
    },
    "callsign": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "squawk": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "position": {
            "type": "object"
          }
        },
        "required": [
          "position"
        ]
      },
      "then": {
        "properties": {
          "timeBasis": {
            "enum": [
              "derived_readsb",
              "receiver_utc",
              "server_arrival"
            ]
          }
        },
        "not": {
          "properties": {
            "positionAtUtc": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
