{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veřejný Aircraft DTO v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lastMessageAt",
    "lastPositionAt",
    "position",
    "positionOrigin",
    "stale",
    "callsign",
    "squawk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(icao|nonicao):[0-9a-f]{6}$"
    },
    "lastMessageAt": {
      "type": "number"
    },
    "lastPositionAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      ]
    },
    "positionOrigin": {
      "enum": [
        "adsb",
        "mlat",
        "tisb",
        "rebroadcast",
        "estimated",
        "unknown"
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "callsign": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "squawk": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        }
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "altitudeBaroFt": {
          "type": "integer",
          "minimum": -2000,
          "maximum": 65000
        },
        "groundSpeedKt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1500
        },
        "trackDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "verticalRateFpm": {
          "type": "integer",
          "minimum": -15000,
          "maximum": 15000
        },
        "onGround": {
          "type": "boolean"
        }
      }
    },
    "emitterCategory": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7",
        "B1",
        "B2",
        "B4",
        "B6",
        "C1",
        "C2"
      ],
      "description": "Volitelná validní ADS-B emitter category z readsb nebo CRC-validního DF17; neodvozovat z letu."
    }
  }
}
