{
  "name": "airradarv2-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4100 --strictPort",
    "prebuild": "node scripts/import-airports.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4100 --strictPort",
    "start": "npm run preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/import-airports.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "npm@11.20.0"
}
