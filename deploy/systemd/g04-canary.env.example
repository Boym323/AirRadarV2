# Šablona; nekopírovat do Gitu jako skutečný env soubor.
# Cílový soubor na DEV: /etc/airradar-v2/g04-canary.env, mode 0600,
# vlastník root:airradarv2. Heslo nikdy nevkládat do unit souboru ani argumentů.
AIRRADAR_V2_DEV_DB_HOST=<schválená-adresa-DB-LXC>
AIRRADAR_V2_DEV_DB_PORT=5432
AIRRADAR_V2_DEV_DB_USER=airradar_v2_dev_app
AIRRADAR_V2_DEV_DB_PASSWORD=<tajemství-z-chráněného-systémového-úložiště>
