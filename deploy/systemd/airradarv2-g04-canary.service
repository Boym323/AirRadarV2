[Unit]
# Unit name: airradarv2-g04-canary.service; nikdy se nepovoluje automaticky.
Description=AirRadar V2 DEV — G-04 historie canary (opt-in)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
# Canary artefact is immutable and SHA-bound; it is never the G-03 current release.
# G-04/ADR 0013: includes bounded graceful SQL drain; old fe0ac66/232d928 not for final canary.
ConditionPathExists=/opt/airradar-v2/canary/releases/e186c54f8304c3e437f6ed9a54c6bd31722dde7c/airradarv2-engine

[Service]
Type=simple
User=airradarv2
Group=airradarv2
WorkingDirectory=/opt/airradar-v2/canary/releases/e186c54f8304c3e437f6ed9a54c6bd31722dde7c
EnvironmentFile=/etc/airradar-v2/g04-canary.env
Environment=AIRRADAR_V2_BIND=127.0.0.1:4114
Environment=AIRRADAR_V2_HISTORY_TRACE=1
ExecStart=/opt/airradar-v2/canary/releases/e186c54f8304c3e437f6ed9a54c6bd31722dde7c/airradarv2-engine --g04-dev-history
# ADR 0011: ručně dozorovaný canary bez automatického SSH/DB monitoru.
# Disk/WAL/CPU/RAM databázového LXC nemají automatickou stop ochranu; nutný osobní dohled.
# Jednorázový, tvrdě omezený běh. Selhání nesmí restartovat canary ani G-03.
Restart=no
# Rust vypne pouze G-04 příjem po 1802 s, drain max 60 s, SQL close max 3 s.
# RuntimeMaxSec=1875 je nouzová pojistka, nikoliv běžný způsob dokončení.
RuntimeMaxSec=1875
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=yes
UMask=0027
LimitNOFILE=4096
CPUQuota=50%
MemoryMax=2G
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/airradar-v2/g04-canary
StandardOutput=journal
StandardError=journal

# Tato jednotka se do DEV LXC sama neinstaluje ani nepovoluje.
# G-03 zůstává v airradarv2-engine.service na portu 4101.
