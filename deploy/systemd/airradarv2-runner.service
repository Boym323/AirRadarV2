[Unit]
Description=AirRadar V2 repository-scoped GitHub Actions runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airradarv2-runner
Group=airradarv2-runner
WorkingDirectory=/var/lib/airradarv2-runner/actions-runner
ExecStart=/var/lib/airradarv2-runner/actions-runner/run.sh
Restart=always
RestartSec=10s
KillMode=process
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/airradarv2-runner /var/lib/airradar-v2/runner/incoming
UMask=0077

[Install]
WantedBy=multi-user.target
